[layer_names]

3d_physics/layer_1="walls"
3d_physics/layer_2="paddles"
3d_physics/layer_3="ball"
3d_physics/layer_4="goals"

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
